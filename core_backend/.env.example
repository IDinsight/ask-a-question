# =============================================================================
# core_backend environment variables
# =============================================================================
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# core_backend does NOT load .env files on its own. Pass it to uv explicitly:
#
#     uv run --env-file .env python -m app.main
#     uv run --env-file .env uvicorn app.main:app --reload
#
# The defaults below match the containers started by `make setup-dev` at the
# repo root (Postgres :5432, Redis :6379, LiteLLM :4000). Keep the Postgres
# credentials in sync with deployment/docker-compose/.core_backend.env, which
# is what that Postgres container was created with.
#
# Uncommented variables are the ones you need for local development.
# Commented-out variables are optional; the value shown is the default used in
# core_backend/app/**/config.py when the variable is not set.
#
# Variables marked 🔒 hold secrets. Never commit real values.
# =============================================================================


#### Prometheus (REQUIRED) ####################################################
# Directory for prometheus_client multiprocess metrics. The app fails to start
# with "env PROMETHEUS_MULTIPROC_DIR is not set or not a directory" without it.
PROMETHEUS_MULTIPROC_DIR=/tmp


#### General ##################################################################
LOG_LEVEL=INFO

# Domain the admin_app is hosted on.
# DOMAIN=localhost

# Path core_backend is served under (e.g. "/api" behind Caddy in docker compose).
# Leave empty when running the backend directly on localhost:8000.
# BACKEND_ROOT_PATH=


#### 🔒 Postgres -- change for production ######################################
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[PASSWORD]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Optional full connection string. Used by app/database.py when set.
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@localhost:5432/postgres

# Number of connections in the SQLAlchemy pool.
# DB_POOL_SIZE=20


#### PGVector #################################################################
# Must match the output size of your embedding model (1536 for OpenAI
# text-embedding-3-small; 1024 for the ARM Hugging Face embeddings image).
# PGVECTOR_VECTOR_SIZE=1536
# PGVECTOR_M=16
# PGVECTOR_EF_CONSTRUCTION=64
# PGVECTOR_DISTANCE=vector_cosine_ops


#### Redis ####################################################################
# For docker compose, use "redis://redis:6379".
REDIS_HOST=redis://localhost:6379


#### 🔒 Auth / JWT -- change for production ####################################
JWT_SECRET=[JWT_SECRET]
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Google OAuth client ID (shared with admin_app). Only needed for Google sign-in.
# NEXT_PUBLIC_GOOGLE_LOGIN_CLIENT_ID=update-me


#### LiteLLM proxy ############################################################
# For docker compose, use "http://litellm_proxy:4000".
LITELLM_ENDPOINT=http://localhost:4000
# The real provider keys (OpenAI, Gemini, ...) live in the LiteLLM proxy config,
# not here. This only needs to match the proxy's master key, if one is set.
LITELLM_API_KEY=[LITELLM_API_KEY]

# Model aliases. Each must match a `model_name` in
# deployment/docker-compose/litellm_proxy_config.yaml.
# LITELLM_MODEL_EMBEDDING=openai/embeddings
# LITELLM_MODEL_DEFAULT=openai/default
# LITELLM_MODEL_CHAT=openai/chat
# LITELLM_MODEL_GENERATION=openai/generate-response
# LITELLM_MODEL_LANGUAGE_DETECT=openai/detect-language
# LITELLM_MODEL_TRANSLATE=openai/translate
# LITELLM_MODEL_SAFETY=openai/safety
# LITELLM_MODEL_PARAPHRASE=openai/paraphrase
# LITELLM_MODEL_ALIGNSCORE=openai/alignscore
# LITELLM_MODEL_URGENCY_DETECT=openai/urgency-detection
# LITELLM_MODEL_DASHBOARD_SUMMARY=openai/dashboard-summary
# LITELLM_MODEL_TOPIC_MODEL=openai/topic-label

# Note: this ONE variable overrides all three DocMuncher models at once
# (title, paraphrase-table, single-line). Their separate defaults are
# openai/docmuncher-title, openai/docmuncher-paraphrase-table and
# openai/docmuncher-single-line.
# LITELLM_MODEL_DOCMUNCHER=


#### Question answering / search ##############################################
# Topic the on/off-topic guardrail checks questions against.
# SERVICE_IDENTITY=air pollution and air quality chatbot

# Number of top content items returned by /search.
# N_TOP_CONTENT=4

# Re-rank search results with a cross-encoder. Must be exactly "True" or "False".
# USE_CROSS_ENCODER=True
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# N_TOP_CONTENT_TO_CROSSENCODER=10

# Minimum alignment score for an LLM response to be returned.
# ALIGN_SCORE_THRESHOLD=0.7

# Default language for uploaded documents.
# DEFAULT_DOC_LANGUAGE=ENGLISH


#### Urgency detection ########################################################
# Choose `cosine_distance_classifier` or `llm_entailment_classifier`.
# URGENCY_CLASSIFIER=cosine_distance_classifier
# Only used with cosine_distance_classifier:
# URGENCY_DETECTION_MAX_DISTANCE=0.5
# Only used with llm_entailment_classifier:
# URGENCY_DETECTION_MIN_PROBABILITY=0.5


#### Content and API quotas ###################################################
# DEFAULT_CONTENT_QUOTA=50
# DEFAULT_API_QUOTA=100
# Estimated content cards per PDF page, used by DocMuncher quota checks.
# PAGES_TO_CARDS_CONVERSION=2

# CHECK_CONTENT_LIMIT and CHECK_API_LIMIT default to on. Setting them to
# "False" here does NOT disable them: the code treats any string as on.
# CHECK_CONTENT_LIMIT=True
# CHECK_API_LIMIT=True


#### Dashboard ################################################################
# Set to "true" to skip LLM calls (AI summaries, topic labels) on the dashboard.
DISABLE_DASHBOARD_LLM=false
# MAX_FEEDBACK_RECORDS_FOR_AI_SUMMARY=100
# MAX_FEEDBACK_RECORDS_FOR_TOP_CONTENT=7
# Context given to the LLM when labelling topic clusters.
# TOPIC_MODELING_CONTEXT=maternal health


#### 🔒 Document ingestion (DocMuncher) ########################################
# Mistral OCR key. Only needed for PDF upload / DocMuncher.
# MISTRAL_API_KEY=[MISTRAL_API_KEY]


#### Speech (voice questions) #################################################
# Self-hosted speech service. When unset, Google Cloud Speech/TTS is used.
# CUSTOM_STT_ENDPOINT=http://localhost:8001/transcribe
# CUSTOM_TTS_ENDPOINT=http://localhost:8001/synthesize

# Google Cloud Storage bucket for speech audio files.
# GCS_SPEECH_BUCKET=aaq-speech-test

# 🔒 Google Cloud credentials, read by the google-cloud-* client libraries.
# Only needed for the Google speech workflow and GCS uploads.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


#### 🔒 Langfuse tracing (via LiteLLM) #########################################
# Must be exactly "True" to enable (case-sensitive).
LANGFUSE=False
# LANGFUSE_PUBLIC_KEY=[LANGFUSE_PUBLIC_KEY]
# LANGFUSE_SECRET_KEY=[LANGFUSE_SECRET_KEY]
# LANGFUSE_HOST=https://cloud.langfuse.com


#### 🔒 Sentry ##################################################################
# Leave unset to disable Sentry.
# SENTRY_DSN=[SENTRY_DSN]
# Fraction of requests traced (1.0 = 100%).
# SENTRY_TRACES_SAMPLE_RATE=1.0


#### Turn.io (WhatsApp) #######################################################
# TURNIO_API_BASE=https://whatsapp.turn.io/v1/


#### 🔒 Dummy-data script only (add_dummy_data_to_db.py) #######################
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=[PASSWORD]
